define flow prevent_prompt_injection:
    if "ignore previous instructions" in user_message:
        bot say_refusal
        stop

# -------------------------------------------------
# INPUT SAFETY
# -------------------------------------------------
define flow content_safety_check_input:
    $result = execute content_safety_check text=user_message
    if not $result.allowed:
        bot say_refusal
        stop

define flow topic_safety_check_input:
    $result = execute topic_safety_check=user_message
    if not $result.allowed:
        bot say_refusal
        stop

# -------------------------------------------------
# OUTPUT SAFETY
# -------------------------------------------------
define flow content_safety_check_output:
    $result = execute content_safety_check text=bot_message
    if not $result.allowed:
        bot say_refusal
        stop

define flow self_check_output:
    $check = execute self_check_output=bot_message
    if not $check.allowed:
        bot say_refusal
        stop
